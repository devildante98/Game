async function offer(p,lim){
  const n=p[0];let g=0;
  while(Math.floor(lvd(n).l/3)>ofd(n)&&g++<(lim||3)){
    S.ofd[n]++;
    const known=moves(p).map(m=>m[0]),pool=ABL.filter(a=>!known.includes(a[0])).sort(()=>Math.random()-.5).slice(0,3);
    if(!pool.length)break;
    await say("¡"+n+" puede aprender una habilidad! Elige una:");
    $("menu").innerHTML=pool.map(a=>'<button data-k="l:'+a[0]+'"><b>'+a[1]+'</b><br><small>'+abDesc(a,p)+'</small></button>').join("")+'<button data-k="l:no">Saltar</button>'+(lim>3?'<button data-k="l:all">Saltar todas las que quedan</button>':'');
    const id=await new Promise(r=>{B.choose=r});
    if(id==="all"){S.ofd[n]=Math.floor(lvd(n).l/3);break}
    if(id==="no")continue;
    const ids=moves(p).map(m=>m[0]);
    if(ids.length>=4){
      await say("¡"+n+" ya conoce 4 habilidades! ¿Cuál olvida para aprender "+MVI(id)[1]+"?");
      $("menu").innerHTML=ids.map((m,i)=>'<button data-k="l:x'+i+'">Olvidar '+mname(MVI(m),p)+'</button>').join("")+'<button data-k="l:no">No aprender</button>';
      const r=await new Promise(r=>{B.choose=r});
      if(r==="no")continue;
      ids[+r.slice(1)]=id;
    }else ids.push(id);
    S.mv[n]=ids;save();
    await say("¡"+n+" ha aprendido "+MVI(id)[1]+"!");
  }
  $("menu").innerHTML="";
}
