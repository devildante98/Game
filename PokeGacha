async function strike(att,def,mv,mine,guard){
  const nm=mname(mv,att),kd=mv[2];
  await say(mine?"¡"+att[0]+" usa "+nm+"!":"¡El "+att[0]+" salvaje usa "+nm+"!");
  if(Math.random()*100>=mv[4]){snd("miss");await say("¡Pero ha fallado!");return false}
  snd("atk",{ty:kd==="n"?"normal":att[1],big:mv[3]>=100});
  await fxAtk(mv,att,mine);
  const hits=kd==="m"?mv[5]:1,e=eff(kd==="n"?"normal":att[1],def[1]),atk=mine?B.ma*(1+.25*B.up):B.oa;
  let tot=0,nh=0;
  for(let h=0;h<hits;h++){
    const d=Math.max(1,Math.round(atk*mv[3]/35*e*(.85+Math.random()*.3)*(guard?.4:1)));tot+=d;nh++;
    if(mine)B.oh-=d;else B.mh-=d;
    const sp=$(mine?"osp":"msp");sp.classList.remove("hit");void sp.offsetWidth;sp.classList.add("hit");snd("hit",e);
    upd();if(hits>1)await sleep(260);
    if((mine?B.oh:B.mh)<=0)break;
  }
  const hl=kd==="d"?Math.round(tot/2):0,rc=kd==="r"?Math.round(tot/4):0;
  if(hl){if(mine)B.mh=Math.min(B.mx,B.mh+hl);else B.oh=Math.min(B.ox,B.oh+hl)}
  if(rc){if(mine)B.mh=Math.max(1,B.mh-rc);else B.oh=Math.max(1,B.oh-rc)}
  upd();await sleep(550);
  if(e>1)await say("¡Es súper eficaz!");else if(e<1)await say("No es muy eficaz...");
  if(nh>1)await say("¡Golpeó "+nh+" veces!");
  if(hl)await say("¡"+att[0]+" drena "+hl+" PS!");
  if(rc)await say("¡"+att[0]+" sufre daño de retroceso!");
  return (mine?B.oh:B.mh)<=0;
}
