// ================= cuenta y guardado en la nube (db + user de la plataforma) =================
const CL={doc:null,ready:false,state:"init",name:"",pending:null,timer:null,busy:false,at:0,err:"",ask:{}};
const clMarker=()=>{try{return +localStorage.getItem("gacha-cl-at")||0}catch(e){return 0}};
const clSetMarker=v=>{try{localStorage.setItem("gacha-cl-at",String(v))}catch(e){}};
const clFresh=()=>!Object.keys(S.owned||{}).length&&!(S.pulls||S.np||S.sp);
function clSum(txt,at){
  let d;try{d=JSON.parse(txt)}catch(e){return "datos ilegibles"}
  const n=Object.keys(d.owned||{}).length,mx=Object.values(d.lv||{}).reduce((a,b)=>Math.max(a,(b&&b.l)||0),0);
  return n+" Pokémon · "+fmt(d.t||0)+" 🎟️"+(mx?" · nivel máx. "+mx:"")+(at?" · "+new Date(at).toLocaleString("es"):"");
}
function clUI(){
  const T={
    init:"Comprobando tu cuenta…",
    local:"Modo local: este navegador guarda tu progreso. La nube solo funciona en el enlace publicado, con sesión iniciada en claude.ai.",
    anon:"Sin cuenta: inicia sesión en claude.ai para guardar tu progreso en la nube. Mientras, se guarda en este navegador.",
    readonly:"Tu nivel de acceso a esta página no permite guardar en la nube. Tu progreso se guarda en este navegador y puedes usar Exportar/Importar.",
    ok:"Conectado"+(CL.name?" como "+CL.name:"")+". Tu progreso se guarda solo, en tu espacio privado"+(CL.at?" (última copia: "+new Date(CL.at).toLocaleTimeString("es")+")":"")+".",
    err:"No se pudo guardar en la nube: "+CL.err+". Se reintentará."};
  $("clInfo").textContent=T[CL.state]||"";
  $("clSt").textContent=CL.state==="ok"?(CL.busy||CL.pending?"☁️ Guardando…":"☁️ Guardado"):CL.state==="err"?"⚠️ Nube sin conexión":"";
  ["clNow","clLoad","clDel"].forEach(id=>{$(id).disabled=CL.state!=="ok"&&!(CL.state==="err"&&CL.doc)});
}
function clMsg(t){$("clMsg").textContent=t}
async function clFlush(){
  if(!CL.ready||CL.busy||!CL.pending)return;
  const j=CL.pending;CL.pending=null;
  if(j===CL.last){clUI();return}
  CL.busy=true;clUI();
  try{
    if(j.length>240000)throw {message:"la partida es demasiado grande para la nube"};
    const at=Date.now();
    await CL.doc.set({v:1,data:j,at:at});
    CL.last=j;CL.at=at;clSetMarker(at);CL.state="ok";CL.err="";
  }catch(e){CL.state="err";CL.err=(e&&e.message)||"error";CL.pending=CL.pending||j;clSched(20000)}
  CL.busy=false;clUI();
  if(CL.pending&&CL.state==="ok")clSched(2000)
}
function clSched(ms){if(CL.timer)return;CL.timer=setTimeout(()=>{CL.timer=0;clFlush()},ms)}
function clNow(){clearTimeout(CL.timer);CL.timer=0;clFlush()}
window.clSave=j=>{if(!CL.ready)return;CL.pending=j;clSched(10000);clUI()};
function clApply(data,at){CL.ready=false;try{localStorage.setItem(KEY,data);clSetMarker(at||0)}catch(e){}location.reload()}
function clChoose(c){
  return new Promise(res=>{
    $("clmCloud").textContent="☁️ Nube: "+clSum(c.data,c.at);
    $("clmLocal").textContent="💻 Este navegador: "+clSum(JSON.stringify(S),0);
    $("clm").hidden=false;
    $("clmUseCloud").onclick=()=>{$("clm").hidden=true;clApply(c.data,c.at);res()};
    $("clmUseLocal").onclick=()=>{$("clm").hidden=true;clSetMarker(c.at||0);CL.ready=true;CL.state="ok";clUI();window.clSave(JSON.stringify(S));clNow();res()};
  });
}
async function clInit(){
  try{
    if(!window.claude||!window.claude.use){CL.state="local";clUI();return}
    const got=await Promise.all([window.claude.use("db"),window.claude.use("user")]),db=got[0],user=got[1];
    if(!db||!user){CL.state="local";clUI();return}
    const me=await user.me();
    if(!me||!me.id){CL.state="anon";clUI();return}
    CL.name=me.name||"";
    if((await user.can("data.write"))===false){CL.state="readonly";clUI();return}
    CL.doc=db.collection("data/users/"+me.id).doc("progress");
    let snap;
    try{snap=await CL.doc.get()}catch(e){CL.state="err";CL.err=(e&&e.message)||"error de lectura";clUI();return}
    const cur=JSON.stringify(S),c=snap.exists?snap.data():null;
    if(c&&typeof c.data==="string"){
      CL.at=c.at||0;
      if(c.data===cur||clMarker()===c.at){CL.ready=true;CL.state="ok";clUI();if(c.data!==cur){window.clSave(cur)}return}
      if(clFresh()){clApply(c.data,c.at);return}
      await clChoose(c);
    }else{
      CL.ready=true;CL.state="ok";clUI();window.clSave(cur);clNow();
    }
  }catch(e){CL.state="err";CL.err=(e&&e.message)||"error";clUI()}
}
function clTwoStep(id,label,fn){
  const b=$(id);
  b.onclick=()=>{
    if(CL.ask[id]){clearTimeout(CL.ask[id]);CL.ask[id]=0;b.textContent=label;fn();return}
    b.textContent="¿Seguro? Pulsa otra vez";CL.ask[id]=setTimeout(()=>{CL.ask[id]=0;b.textContent=label},3500);
  };
}
function clBind(){
  $("clNow").onclick=()=>{if(!CL.ready)return;window.clSave(JSON.stringify(S));clNow();clMsg("Guardando en la nube…")};
  clTwoStep("clLoad","Cargar la copia de la nube",async()=>{
    try{const sn=await CL.doc.get(),c=sn.exists&&sn.data();if(!c||typeof c.data!=="string"){clMsg("No hay ninguna copia en la nube.");return}clApply(c.data,c.at)}catch(e){clMsg("No se pudo leer la nube.")}
  });
  clTwoStep("clDel","Borrar la copia de la nube",async()=>{
    try{await CL.doc.delete();CL.at=0;clSetMarker(0);clMsg("Copia de la nube borrada. Tu progreso local sigue intacto y se volverá a subir al guardar.");window.clSave(JSON.stringify(S))}catch(e){clMsg("No se pudo borrar.")}
  });
  $("clExp").onclick=async()=>{
    try{
      const d=window.claude&&window.claude.use?await window.claude.use("downloads"):null;
      if(!d){clMsg("Tu navegador o esta vista no permite descargar archivos.");return}
      await d.save({filename:"capsula-pokemon-partida.json",data:JSON.stringify(S)});clMsg("Partida exportada.");
    }catch(e){clMsg(e&&e.code==="declined"?"Descarga cancelada.":"No se pudo exportar la partida.")}
  };
  $("clImp").onclick=()=>$("clFile").click();
  $("clFile").onchange=async()=>{
    const f=$("clFile").files[0];$("clFile").value="";if(!f)return;
    try{
      const t=await f.text(),d=JSON.parse(t);
      if(!d||typeof d!=="object"||typeof d.owned!=="object"||typeof d.t!=="number")throw 0;
      CL.imp=t;clMsg("Archivo válido: "+clSum(t,0)+". Pulsa «Confirmar importación» para sustituir tu partida actual.");
      $("clImpOk").hidden=false;
    }catch(e){clMsg("Ese archivo no es una partida válida.");$("clImpOk").hidden=true}
  };
  $("clImpOk").onclick=()=>{if(!CL.imp)return;try{localStorage.setItem(KEY,CL.imp);if(CL.at)clSetMarker(CL.at)}catch(e){}CL.ready=false;location.reload()};
}

function sortDex(a){
  const o=$("fo").value;if(!o)return a;
  const w=p=>(S.when&&S.when[p[0]])||0,c=p=>S.owned[p[0]]||0;
