const pvOpp=()=>{if(!D)return null;const p=D.DR.peers().find(x=>!x.isMe&&x.kind==="viewer"&&x.presence&&x.presence.pv&&x.presence.pv.v===1);return p?p.presence.pv:null};
function pvDPub(){const h={};Object.keys(D.hist).slice(-8).forEach(k=>{h[k]=D.hist[k]});D.DR.presence({pv:Object.assign({},D.base,{h:h})}).catch(()=>{})}
async function pvStart(role,room,seed){
  PV.st="duel";pvPub();
  let DR;try{DR=await PR.join(room)}catch(e){PV.st="idle";PV.ch=null;PV.ok=null;pvPub();pvMsg("No se pudo entrar en la sala del duelo.");return}
  D={role:role,room:room,DR:DR,seed:seed,hist:{},st:null,playing:false,over:false,t0:Date.now(),lastSeen:Date.now(),sw:false,waitSince:0,base:{v:1,n:pvClean(pvNick()),r:role,team:pvTeamData()},shown:{}};
  D.unsub=DR.onPeers(()=>pvTick());D.iv=setInterval(pvTick,400);
  $("pvLobby").hidden=true;$("pvDuel").hidden=false;$("pvVs").textContent="Duelo online";setScene($("pvScene"),"grass");
  $("pvBox").textContent="Preparando el duelo…";$("pvMenu").innerHTML="";
  pvDPub();pvTick();
}
const pvKey=()=>D.st.turn+":"+((D.st.need.A||D.st.need.B)?"swap":"act");
function pvTick(){
  if(!D||D.over)return;
  const op=pvOpp(),other=D.role==="A"?"B":"A";
  if(op)D.lastSeen=Date.now();
  if(!D.st){
    if(op&&pvOkTeam(op.team)&&pvOkTeam(D.base.team)){
      const mine=D.base.team,theirs=op.team;
      D.st=pvInit(D.role==="A"?mine:theirs,D.role==="A"?theirs:mine,D.seed);
      D.oppNick=pvClean(op.n);$("pvVs").textContent=pvClean(D.base.n)+" ⚔️ "+D.oppNick;
      pvPaintSnap(pvSnap(D.st));$("pvBox").textContent="¡Duelo contra "+D.oppNick+"!";
      pvMenu();
    }else if(Date.now()-D.t0>25000)pvEnd("timeout");
    return;
  }
  if(op&&op.ff){pvEnd("ff");return}
  if(!op&&Date.now()-D.lastSeen>7000){pvEnd("left");return}
  if(D.playing)return;
  const key=pvKey(),need=D.st.need,swap=need.A||need.B;
  const mineReq=swap?need[D.role]:true,theirReq=swap?need[other]:true;
  const mine=mineReq?D.hist[key]:"-",theirs=theirReq?(op&&op.h&&op.h[key]):"-";
  if(mine==null){pvMenu();return}
  if(theirs==null||!op){pvMenu();return}
  pvPlayTurn(key,D.role==="A"?mine:theirs,D.role==="A"?theirs:mine);
}
function pvAct(a){
  if(!D||!D.st||D.playing||D.over)return;
  const key=pvKey();if(D.hist[key]!=null)return;
  D.hist[key]=a;D.sw=false;D.waitSince=Date.now();pvDPub();pvMenu();snd("ui");pvTick();
}
async function pvPlayTurn(key,aA,aB){
  D.playing=true;pvMenu();
  const ev=(D.st.need.A||D.st.need.B)?pvSwap(D.st,aA,aB):pvTurnRes(D.st,aA,aB);
  await pvPlay(ev);
  D.playing=false;
  if(D.st.over){pvEnd("done");return}
  D.waitSince=0;pvMenu();pvTick();
}
function pvTxt(e){
  const m=e.s===D.role,n=e.n;
  switch(e.k){
    case "use":return m?"¡"+n+" usa "+e.mv+"!":"¡"+n+" rival usa "+e.mv+"!";
    case "miss":return "¡Pero ha fallado!";
    case "hit":return e.e>1?"¡Es súper eficaz!":e.e<1?"No es muy eficaz...":"";
    case "heal":return n+" recupera "+e.h+" PS.";
    case "guard":return "¡"+n+" se protege!";
    case "up":return "¡"+n+" sube su ataque!";
    case "send":return m?"¡Adelante, "+n+"!":"El rival envía a "+n+".";
    case "faint":return m?"¡"+n+" se debilitó!":"¡"+n+" rival se debilitó!";
    case "drain":return n+" drena "+e.hl+" PS.";
    case "recoil":return n+" sufre daño de retroceso.";
    case "multi":return "¡Golpeó "+e.c+" veces!";
    case "win":return e.s===D.role?"¡Has ganado el duelo!":"Has perdido el duelo...";
  }
  return "";
}
function pvPaintSnap(sn){
  const me=D.role,op=me==="A"?"B":"A";
  [["M",me],["O",op]].forEach(a=>{
    const w=a[0],sd=a[1],i=sn.ai[sd],t=D.st[sd].t[i],hp=Math.max(0,sn.hp[sd][i]),sp=$("pv"+w+"s"),tag=sd+i+t.p[0];
    if(D.shown[w]!==tag){D.shown[w]=tag;sp.innerHTML=ico(t.p,92);sp.className="spr "+(w==="M"?"s-me":"s-opp");sp.style.filter="drop-shadow(0 0 12px "+GLW[t.p[2]]+")"}
    $("pv"+w+"n").textContent=t.p[0];$("pv"+w+"l").textContent=STAR[t.p[2]]+" "+TIPO[t.p[1]]+" Nv"+t.l;
    const pc=hp/t.mx,bar=$("pv"+w+"h");bar.style.width=pc*100+"%";bar.style.background=pc>.5?"#3ecf5a":pc>.2?"#f5c400":"#e63950";
    $("pv"+w+"t").textContent="PS "+hp+" / "+t.mx+" · "+D.st[sd].t.map((x,j)=>sn.hp[sd][j]>0?"●":"○").join("");
  });
}
async function pvSay(t){const b=$("pvBox");b.textContent="";for(const c of t){b.textContent+=c;await sleep(10)}}
async function pvPlay(ev){
  for(const e of ev){
    pvPaintSnap(e.snap);
    const tw=e.s==="A"?"B":"A",w=(e.k==="hit")?(tw===D.role?"M":"O"):(e.s===D.role?"M":"O"),sp=$("pv"+w+"s");
    if(e.k==="hit"){sp.classList.remove("hit");void sp.offsetWidth;sp.classList.add("hit");snd("atk",{ty:e.t,big:e.big});snd("hit",e.e)}
    if(e.k==="faint"){sp.classList.add("faint");snd("faint")}
    if(e.k==="heal"||e.k==="up"||e.k==="guard")snd(e.k==="heal"?"heal":e.k==="guard"?"guard":"buff");
    if(e.k==="send")snd("pop");
    const t=pvTxt(e);if(t){await pvSay(t);await sleep(520)}else await sleep(350);
  }
}
