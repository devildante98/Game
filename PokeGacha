const TSK=["#f6d3b3","#e9b98f","#c98d5f","#8d5a3b"],THC=["#2b2118","#5b3a1e","#a2561f","#d9a441","#c43c3c","#3b5bdb","#7b4bb7","#e8e8ee"];
