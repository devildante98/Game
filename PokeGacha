  <div class="mrow"><button id="mprev" aria-label="Anterior">⏮</button><button id="mplay" aria-label="Reproducir o pausar">▶</button><button id="mstop" aria-label="Detener">⏹</button><button id="mnext" aria-label="Siguiente">⏭</button></div>
  <label>🎵 Música <input id="vol" type="range" min="0" max="1" step=".05" style="flex:1"></label>
