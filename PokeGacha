  if(has("excursion","montañ","minero","aventur"))L.acc="hat";
  if(has("científ")){L.acc="glasses";L.coat=true}
  if(has("karate","luchad","boxead")){L.acc="band";L.top="#f4f2ff"}
  if(has("naded","marin","pescad"))L.acc="cap";
  if(has("hielo","reina")){L.top="#8fd4ff";L.acc="scarf"}
  if(has("médium","mentalis","sabia","espectral","fantasma","narrador","espectro","guardiana")){L.dress=true;L.top="#6b3fa0";L.acc="veil";L.long=true}
  if(has("hada")){L.dress=true;L.top="#ff8fc7";L.long=true}
  if(has("ninja","siniestro","sombra")){L.acc="mask";L.top="#2b2b34";L.pants="#2b2b34"}
  if(has("jardin","planta")){L.acc="hat";L.top="#2fa36b"}
  if(has("piro","fuego","motero")){L.top="#e8602c"}
  if(has("campe","veterano")){L.cape=true;L.acc="crown";L.hair=h%2?"#e8e8ee":L.hair}
  return L;
}
